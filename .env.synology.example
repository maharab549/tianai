# Copy this file to .env on the Synology project directory and replace every placeholder.
JWT_SECRET=replace-with-a-long-random-secret
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-cloudflared-token-from-zero-trust

# Public hostname used for Cloudflare Access/CORS documentation.
CLIENT_ORIGIN=https://ai.example.com
VITE_API_URL=/api

# Keep the origin services reachable only from the NAS itself.
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1
POSTGRES_BIND=127.0.0.1
MINIO_BIND=127.0.0.1
MINIO_CONSOLE_BIND=127.0.0.1

POSTGRES_DB=tianai
POSTGRES_USER=tianai
POSTGRES_PASSWORD=replace-with-a-database-password
MINIO_ROOT_USER=tianai
MINIO_ROOT_PASSWORD=replace-with-a-minio-password

# Qwen3 GGUF is downloaded once into the persistent backend_models volume.
LOCAL_LLM_CONTEXT_SIZE=4096
LOCAL_LLM_GPU=false
LOCAL_LLM_AUTO_DOWNLOAD=true
# Stock DS925+ memory is limited; use these smaller-model values unless the NAS is upgraded.
# LOCAL_LLM_MODEL_FILE=Qwen3-0.6B-Q8_0.gguf
# LOCAL_LLM_MODEL_URL=https://huggingface.co/Qwen/Qwen3-0.6B-GGUF/resolve/main/Qwen3-0.6B-Q8_0.gguf?download=true
LEARNING_AUTO_RETRAIN_THRESHOLD=20
LEARNING_LLM_REVIEW=true
LEARNING_REVIEW_WORKER=false

# A Synology CPU can run inference and profile learning. QLoRA training needs a separate
# Python environment and enough RAM; configure TRAINING_PYTHON only when that is available.
TRAINING_PYTHON=python
TRAINING_BASE_MODEL=Qwen/Qwen3-4B
TRAINING_LORA_CONVERTER=
