JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
DATA_DIR=./backend/data
STORAGE_DIR=./backend/storage
# The backend downloads and runs this GGUF model directly with node-llama-cpp.
LOCAL_LLM_MODEL_DIR=./backend/models
LOCAL_LLM_MODEL_FILE=Qwen3-4B-Q4_K_M.gguf
LOCAL_LLM_MODEL_URL=https://huggingface.co/Qwen/Qwen3-4B-GGUF/resolve/main/Qwen3-4B-Q4_K_M.gguf?download=true
LOCAL_LLM_CONTEXT_SIZE=8192
LOCAL_LLM_MAX_TOKENS=500
LOCAL_LLM_GPU=auto
LOCAL_LLM_AUTO_DOWNLOAD=true
# Automatic self-learning: high-confidence learnings become active immediately.
LEARNING_MIN_CONFIDENCE=0.82
LEARNING_AUTO_RETRAIN_THRESHOLD=20
LEARNING_REVIEW_WORKER=false
LEARNING_LLM_REVIEW=true
TRAINING_PYTHON=python
TRAINING_BASE_MODEL=Qwen/Qwen3-4B
# Optional llama.cpp conversion script. It should write adapter.gguf into the job output directory.
TRAINING_LORA_CONVERTER=
LOCAL_LLM_LORA_PATH=
# Optional local CosyVoice FastAPI server for consented zero-shot voice cloning.
COSYVOICE_URL=http://127.0.0.1:50000
VOICE_SAMPLE_RATE=22050
# Optional ffmpeg binary used to normalize reference recordings to mono 16 kHz WAV.
AUDIO_FFMPEG_BIN=ffmpeg
# Optional local OCR/ASR service exposing POST /extract for formats without a built-in parser.
DOCUMENT_PROCESSOR_URL=
# Optional when moving from the local adapter to PostgreSQL-backed repositories:
DATABASE_URL=postgresql://tianai:tianai@localhost:5432/tianai
